<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="${%DevBuild Discord Publisher}">
    <f:entry title="${%Webhooks}">
      <f:repeatableProperty field="webhooks" add="${%Add webhook}" minimum="0"/>
    </f:entry>
    <f:entry title="${%Default webhook}" field="defaultWebhookName">
      <f:select/>
    </f:entry>
    <f:optionalProperty field="message" title="${%Default message settings}"/>
    <f:optionalProperty field="embed" title="${%Default embed settings}"/>
    <f:optionalProperty field="artifacts" title="${%Default attachment settings}"/>
    <f:optionalProperty field="conditions" title="${%Default notify conditions}"/>
    <f:advanced>
      <f:entry title="${%Request timeout (seconds)}" field="timeoutSeconds">
        <f:number default="30" min="1"/>
      </f:entry>
      <f:entry title="${%Maximum retries}" field="maxRetries">
        <f:number default="3" min="0"/>
      </f:entry>
    </f:advanced>
  </f:section>
</j:jelly>
