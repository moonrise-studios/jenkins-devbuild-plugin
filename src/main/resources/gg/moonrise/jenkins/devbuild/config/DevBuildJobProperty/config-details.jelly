<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry field="autoPublish">
    <f:checkbox title="${%Post every completed build automatically}" default="true"/>
  </f:entry>
  <f:entry field="skipIfStepUsed">
    <f:checkbox title="${%Skip the automatic post when the step or post-build action already ran}" default="true"/>
  </f:entry>
  <f:entry title="${%Named webhook}" field="webhookName">
    <f:select/>
  </f:entry>
  <f:optionalProperty field="webhook" title="${%Use a webhook defined here}"/>
  <f:optionalProperty field="message" title="${%Customize the message}"/>
  <f:optionalProperty field="embed" title="${%Customize the embed}"/>
  <f:optionalProperty field="artifacts" title="${%Customize attached files}"/>
  <f:optionalProperty field="conditions" title="${%Customize when to notify}"/>
</j:jelly>
